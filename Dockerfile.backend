# STAGE 1: Builder
FROM golang:1.23 AS builder

# Impostiamo la cartella di lavoro
WORKDIR /src

# Copiamo tutto il progetto (che include la cartella cmd/)
COPY . .

# compilare dentro "cmd/webapi"
RUN go build -o webapi ./cmd/webapi

# STAGE 2: Final (Debian Bookworm per SQLite)
FROM debian:bookworm

WORKDIR /app

# Copiamo l'eseguibile creato nello stage 1
COPY --from=builder /src/webapi ./webapi

# --- Permessi utente 1000) ---
RUN chown -R 1000:1000 /app

EXPOSE 3000

CMD ["/app/webapi"]
